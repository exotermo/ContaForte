# Copie para .env com `./cf init` (gera segredos aleatórios). NUNCA commite o .env.
COMPOSE_PROJECT_NAME=contaforte

# Gateway local (publicado apenas em 127.0.0.1)
GATEWAY_PORT=8080

# Postgres
POSTGRES_DB=contaforte
POSTGRES_USER=contaforte
POSTGRES_PASSWORD=change-me

# Redis
REDIS_PASSWORD=change-me

# MQTT
MQTT_USER=contaforte
MQTT_PASSWORD=change-me

# Administrador inicial e Grafana (gerados por ./cf init)
ADMIN_EMAIL=admin@contaforte.local
ADMIN_PASSWORD=change-me
GRAFANA_PASSWORD=change-me
